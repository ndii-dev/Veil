PORT=4000
NODE_ENV=development

# Stellar network (testnet | mainnet)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Contract IDs — deployed to Stellar testnet 2026-06-28
# Replace with your own after running shieldfund-contracts/scripts/deploy-testnet.sh
TREASURY_VAULT_CONTRACT_ID=CAUWJPC73YLQMSV6X4QPLUVS2UZFE2PMRIQSSCDN62DNN6J76Y5RETIG
STREAMING_CONTRACT_ID=CDU7ZIVQ3UC4K3DHV3NMQGW5UMSYFCKCC6YJKHT4YLNEZJRWL6THE6WQ
PROOF_REGISTRY_CONTRACT_ID=CBDLHQQPKC5524CFWPD4HMPTZGWBYQNW3IKGAFH6IAYBU3F2F6AO2332

# SQLite database path (default: ./data/shieldfund.db)
# DB_PATH=./data/shieldfund.db

# Comma-separated frontend origins allowed by CORS (required when NODE_ENV=production)
CORS_ORIGINS=http://localhost:5173
# Reverse-proxy hops in front of the app (1 on Railway) for correct rate-limit IPs
TRUST_PROXY=0

# Bearer token for admin write routes (POST /api/campaigns, POST /api/proofs).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Write-route rate limit (per IP)
WRITE_RATE_LIMIT_WINDOW_MS=900000
WRITE_RATE_LIMIT_MAX=30

# shieldfund-proof-server — generates and bb-verifies proofs
PROOF_SERVER_URL=http://localhost:4100
PROOF_SERVER_TIMEOUT_MS=120000
# Secret seed (S...) of the dedicated key that signs register_proof().
# Must be the proof_registry admin (see transfer_admin). Never commit it.
PROOF_SUBMITTER_SECRET=

# Periodic SQLite snapshots (unset DB_BACKUP_DIR to disable)
# DB_BACKUP_DIR=./backups
# DB_BACKUP_INTERVAL_MINUTES=60
# DB_BACKUP_KEEP=48

# Optional: Pinata IPFS for campaign metadata. Use a scoped JWT with
# pin-only permissions (pinFileToIPFS, pinJSONToIPFS), not a full API key pair.
PINATA_JWT=
